# Plantilla pública sin credenciales. Desde la raíz: npm run env:init
# Ese comando crea .env con un secreto aleatorio y conserva un .env existente.
# Solo el backend lee estas variables. Nunca usar VITE_* para secretos.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Origen exacto del navegador; en producción debe usar HTTPS.
APP_ORIGIN=http://localhost:5173
# Rutas relativas a la raíz. Estas bases privadas no se suben a GitHub.
DATABASE_PATH=server/data/tienda.sqlite
SESSION_DATABASE_PATH=server/data/sessions.sqlite
# Obligatorio: mínimo 32 bytes aleatorios (64 caracteres hexadecimales).
# Se deja vacío deliberadamente; npm run env:init lo genera sin imprimirlo.
SESSION_SECRET=
# false sin proxy; con proxy controlado, indicar el número exacto de saltos.
TRUST_PROXY=false

# Administrador: npm run db:init y npm run admin:create.
# El comando pide usuario y contraseña oculta (15–128 caracteres).
# SQLite guarda solo el hash Argon2id. No existe ADMIN_PASSWORD en el entorno.
# WhatsApp: iniciar sesión en Administración y guardar el celular del negocio.
# Se guarda en SQLite; no existe WHATSAPP_NUMBER en el entorno.
# Formato: 9 dígitos empezando por 9; admite 51 o +51 opcional.
# Consulta README.md para los pasos completos y las reglas de Git.
